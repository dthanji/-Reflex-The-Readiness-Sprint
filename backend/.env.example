# Copy this to .env and fill in real values. Never commit the actual .env file.

# --- Required in production ---

# Long random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the app refuses to start when NODE_ENV=production. In
# development it falls back to a random per-process value (see backend/src/auth.js).
JWT_SECRET=

# Comma-separated list of origins allowed to make cross-origin browser
# requests to this API (e.g. the domain your PWA is served from). Requests
# with no Origin header (curl, same-origin) are always allowed regardless.
# Leave empty to block all cross-origin browser requests.
ALLOWED_ORIGINS=https://yourdomain.example.com

# --- Database ---
# Option A: a single connection string (Render, Heroku, Railway, and most
# managed Postgres hosts provide this). Takes priority over the individual
# PG* vars below if set.
DATABASE_URL=

# Set to "require" if your host's connection string needs SSL (e.g. Render's
# *external* database URL does; its *internal* URL — used when your app and
# database are in the same account/region — does not).
PGSSLMODE=

# Option B: individual fields, used only if DATABASE_URL is not set.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=reflex

# --- Server ---
PORT=3000
NODE_ENV=production
