# Copy to .env for local use. Never commit real secrets.
JWT_SECRET=
JWT_ACCESS_TTL=30m
ALLOWED_ORIGINS=https://yourdomain.example.com
DATABASE_URL=
PGSSLMODE=
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=reflex
PORT=3000
NODE_ENV=production

# Tunable safety/performance limits
JSON_BODY_LIMIT_BYTES=32768
METADATA_MAX_BYTES=8192
METADATA_MAX_DEPTH=5
METADATA_MAX_KEYS=50
METADATA_MAX_ARRAY_ITEMS=50
METADATA_MAX_STRING_LENGTH=2000
CLIENT_EVENT_ID_MAX_LENGTH=128
RATING_COMMENT_MAX_LENGTH=500
STUCK_IN_TRANSIT_HOURS=24
STUCK_MONITOR_MINUTES=15
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=20
API_RATE_WINDOW_MS=60000
API_RATE_MAX=120
